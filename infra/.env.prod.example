# Copy this to ~/ignis/.env.prod on your VM — never commit the real file

# App
NODE_ENV=production
PORT=3001
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRY=7d

# Database (matches docker-compose postgres service)
DATABASE_URL=postgresql://ignis:ignis@postgres:5432/ignis

# Redis (matches docker-compose redis service)
REDIS_URL=redis://redis:6379

# Qdrant (matches docker-compose qdrant service)
QDRANT_URL=http://qdrant:6333

# Google
GOOGLE_API_KEY=your_google_ai_studio_key
GCS_BUCKET=your_gcs_bucket_name
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Query pipeline
NS_ROUTING_THRESHOLD=0.3
RERANK_THRESHOLD=0.1
RERANKER_URL=http://reranker:8001
