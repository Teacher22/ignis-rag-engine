NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgres://ignis:ignis@localhost:5432/ignis

# Qdrant
QDRANT_URL=http://localhost:6333

# Redis
REDIS_URL=redis://localhost:6379

# AI Providers (single Google key covers both embeddings + LLM — free tier)
GOOGLE_API_KEY=AIza...        # aistudio.google.com/app/apikey
COHERE_API_KEY=               # optional — leave blank to use self-hosted reranker sidecar

# Self-hosted reranker (optional, used when COHERE_API_KEY is empty)
RERANKER_URL=http://localhost:8001

# Google Cloud Storage
# Option A — path to your service account JSON key file (local dev)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your-service-account.json
# Option B — paste the entire JSON content as a single-line string (containers / CI)
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
GCS_BUCKET=your-gcs-bucket-name

# Security
JWT_SECRET=change-me-to-a-very-long-random-secret-value-in-production

# Query pipeline tuning
NS_ROUTING_THRESHOLD=0.35
RERANK_THRESHOLD=0.3

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
